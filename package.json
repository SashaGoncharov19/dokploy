{
	"name": "dokploy",
	"private": true,
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"scripts": {
		"dokploy:setup": "bun run --filter dokploy setup",
		"dokploy:dev": "bun run --filter dokploy dev",
		"dokploy:build": "bun run --filter dokploy build",
		"dokploy:start": "bun run --filter dokploy start",
		"test": "bun run --filter dokploy test",
		"server:script": "bun run --filter @dokploy/server switch:dev",
		"server:dev": "bun run --filter @dokploy/server dev",
		"server:build": "bun run --filter @dokploy/server build",
		"docker:build:canary": "./apps/dokploy/docker/build.sh canary",
		"typecheck": "bun run --filter '*' typecheck",
		"build": "bun run --filter '*' build",
		"format-and-lint": "biome check .",
		"check": "biome check --write --no-errors-on-unmatched --files-ignore-unknown=true",
		"format-and-lint:fix": "biome check . --write",
		"generate:openapi": "bun run --filter dokploy generate:openapi"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.7",
		"@types/node": "^24.4.0",
		"dotenv": "16.4.5",
		"esbuild": "0.20.2",
		"lint-staged": "^15.5.2",
		"tsx": "4.22.4"
	},
	"engines": {
		"bun": ">=1.3.14"
	},
	"lint-staged": {
		"*": [
			"biome check --write --no-errors-on-unmatched --files-ignore-unknown=true"
		]
	},
	"overrides": {
		"@types/react": "18.3.5",
		"@types/react-dom": "18.3.0",
		"esbuild": "0.20.2",
		"better-call": "1.3.7",
		"@better-fetch/fetch": "1.3.1",
		"@codemirror/view": "6.43.6"
	},
	"trustedDependencies": [
		"@scarf/scarf",
		"@tree-sitter-grammars/tree-sitter-yaml",
		"bcrypt",
		"better-sqlite3",
		"core-js-pure",
		"cpu-features",
		"esbuild",
		"msgpackr-extract",
		"node-pty",
		"protobufjs",
		"sharp",
		"ssh2",
		"tree-sitter",
		"tree-sitter-json"
	]
}
