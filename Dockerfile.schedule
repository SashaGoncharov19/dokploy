# syntax=docker/dockerfile:1
FROM oven/bun:1.4.2-slim AS base

FROM base AS build
WORKDIR /usr/src/app

# Build toolchain for the remaining native dependencies: ssh2's optional crypto
# binding, cpu-features, and the tree-sitter parsers swagger-ui pulls in.
# node-pty and bcrypt are gone - replaced by Bun.Terminal and Bun.password.
#
# Node is required here even though nothing runs on it: node-gyp is a Node
# program, and the oven/bun image ships no node binary. It stays in the build
# stage only and never reaches the runtime image.
RUN apt-get update && apt-get install -y python3 make g++ curl ca-certificates \
 && curl -fsSL https://deb.nodesource.com/setup_24.x | bash - \
 && apt-get install -y nodejs \
 && npm install -g node-gyp \
 && rm -rf /var/lib/apt/lists/*

COPY . .
RUN --mount=type=cache,id=bun,target=/root/.bun/install/cache bun install --frozen-lockfile

ENV NODE_ENV=production
RUN bun run --filter @dokploy/schedules build

FROM base AS dokploy
WORKDIR /app
ENV NODE_ENV=production

# `bun build` emits a self-contained bundle plus any native addons it extracted,
# so dist/ is the whole application - no node_modules in the runtime image.
COPY --from=build /usr/src/app/apps/schedules/dist ./dist

ENV HOSTNAME=0.0.0.0
CMD ["bun", "dist/index.js"]
