{
	"name": "@dokploy/api",
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "PORT=4000 bun --watch src/index.ts",
		"dev:inngest": "bunx --bun inngest-cli@1.9.0 dev -u http://localhost:4000/api/inngest --no-discovery",
		"build": "rm -rf dist && bun build ./src/index.ts --target=bun --outdir=dist --minify --sourcemap",
		"start": "bun dist/index.js",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@dokploy/server": "workspace:*",
		"@hono/zod-validator": "0.7.6",
		"hono": "^4.11.7",
		"inngest": "3.40.1",
		"pino": "9.4.0",
		"pino-pretty": "11.2.2",
		"react": "19.2.7",
		"react-dom": "19.2.7",
		"zod": "^4.3.6"
	},
	"devDependencies": {
		"@types/node": "^24.4.0",
		"@types/react": "^19.2.0",
		"@types/react-dom": "^19.2.0",
		"typescript": "^7.0.2"
	},
	"engines": {
		"bun": ">=1.3.14"
	}
}
